/generated-artifacts/
# Generated documents and verification renders; public manual remains included
/generated-artifacts/
# The format of this file is identical to `.dockerignore`.
# It is used to reduce the size of deployed images to make the process of publishing faster.

# No need to store the pnpm store twice.
.local

# Dependencies are installed again inside the publishing build image.
node_modules

# Local repository and tool caches are not runtime inputs.
.git
.cache
.gradle
.gradle-*

# Native/mobile build intermediates are not needed by the published services.
**/.cxx
**/build
