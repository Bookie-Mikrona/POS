<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    package="com.bookievivabridge"
    android:versionCode="12"
    android:versionName="1.2.0">
  <uses-sdk android:minSdkVersion="23" android:targetSdkVersion="35" />
  <uses-permission android:name="android.permission.INTERNET" />
  <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
  <uses-permission android:name="android.permission.FOREGROUND_SERVICE_DATA_SYNC" />
  <application
      android:allowBackup="false"
      android:label="Bookie Terminal Bridge"
      android:theme="@android:style/Theme.Material.Light.NoActionBar">
    <activity
        android:name=".MainActivity"
        android:configChanges="keyboard|keyboardHidden|orientation|screenSize|screenLayout|uiMode"
        android:excludeFromRecents="true"
        android:exported="true"
        android:launchMode="singleTask">
      <intent-filter>
        <action android:name="android.intent.action.MAIN" />
        <category android:name="android.intent.category.LAUNCHER" />
      </intent-filter>
      <intent-filter>
        <action android:name="android.intent.action.VIEW" />
        <category android:name="android.intent.category.DEFAULT" />
        <category android:name="android.intent.category.BROWSABLE" />
        <data android:scheme="bookie-viva-bridge" android:host="pay" />
        <data android:scheme="bookie-viva-bridge" android:host="payten" />
        <data android:scheme="bookie-viva-bridge" android:host="pair" />
      </intent-filter>
    </activity>
    <activity
        android:name=".CallbackActivity"
        android:excludeFromRecents="true"
        android:exported="true"
        android:launchMode="singleTask"
        android:noHistory="true"
        android:theme="@android:style/Theme.Material.Light.NoActionBar">
      <intent-filter>
        <action android:name="android.intent.action.VIEW" />
        <category android:name="android.intent.category.DEFAULT" />
        <category android:name="android.intent.category.BROWSABLE" />
        <data android:scheme="bookie-viva-bridge" android:host="result" />
      </intent-filter>
    </activity>
    <service
        android:name=".BridgeResultService"
        android:exported="false"
        android:foregroundServiceType="dataSync" />
  </application>
</manifest>