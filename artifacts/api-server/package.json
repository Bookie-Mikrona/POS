{
  "name": "@workspace/api-server",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "test:release": "pnpm run test:release:api && pnpm run test:release:webhook && pnpm run test:release:offline-native && pnpm run test:release:offline-cloud",
    "test:release:api": "node ../../scripts/validate-pos-events-release.mjs api",
    "test:release:webhook": "node ../../scripts/validate-pos-events-release.mjs public-stripe-webhook",
    "test:release:offline-native": "node ../../scripts/validate-pos-events-release.mjs offline-native",
    "test:release:offline-cloud": "node ../../scripts/validate-pos-events-release.mjs offline-cloud",
    "generate:srs-chart": "tsx scripts/generate-srs2024-chart.ts",
    "generate:company-chart": "tsx scripts/generate-company-chart.ts",
    "generate:furs-v1-golden": "tsx scripts/generate-furs-v1-golden.ts --write",
    "generate:furs-v2-golden": "tsx scripts/generate-furs-v2-golden.ts --write",
    "diagnose:event-transfers": "tsx scripts/diagnose-event-stock-transfers.ts",
    "predev": "pnpm run generate:srs-chart",
    "pretest": "tsx scripts/apply-test-migrations.ts",
    "dev": "export NODE_ENV=development && node --import tsx --watch src/index.ts",
    "prebuild": "pnpm run generate:srs-chart",
    "build": "node ./build.mjs",
    "start": "node --enable-source-maps ./dist/index.mjs",
    "pretypecheck": "pnpm -w run typecheck:libs",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "test:backup-roundtrip": "vitest run --config vitest.backup-roundtrip.config.ts",
    "test:watch": "vitest"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.78.0",
    "@clerk/express": "^2.1.43",
    "@clerk/shared": "^4.25.5",
    "@google-cloud/storage": "^7.21.0",
    "@napi-rs/canvas": "^1.0.5",
    "@types/pdfkit": "^0.17.6",
    "@workspace/api-zod": "workspace:*",
    "@workspace/db": "workspace:*",
    "@workspace/integrations-anthropic-ai": "workspace:*",
    "@workspace/integrations-gemini-ai": "workspace:*",
    "@xmldom/xmldom": "^0.9.12",
    "bcryptjs": "^3.0.3",
    "cookie-parser": "^1.4.7",
    "cors": "^2.8.6",
    "decimal.js": "^10.6.0",
    "drizzle-orm": "catalog:",
    "exceljs": "^4.4.0",
    "express": "^5.2.1",
    "fast-xml-parser": "^5.10.1",
    "google-auth-library": "^10.9.0",
    "http-proxy-middleware": "^4.2.0",
    "iconv-lite": "^0.7.3",
    "imapflow": "^1.6.5",
    "jszip": "^3.10.1",
    "mailparser": "^3.9.14",
    "multer": "^2.2.0",
    "nodemailer": "^9.0.3",
    "papaparse": "^5.5.4",
    "pdfkit": "^0.19.1",
    "pino": "^9.14.0",
    "pino-http": "^10.5.0",
    "qrcode": "^1.5.4",
    "stripe": "22.6.0",
    "stripe-replit-sync": "1.0.0",
    "xml-crypto": "^6.1.2",
    "xmlbuilder2": "^4.0.3",
    "zod": "catalog:"
  },
  "devDependencies": {
    "@types/bcryptjs": "^3.0.0",
    "@types/cookie-parser": "^1.4.10",
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.6",
    "@types/jszip": "^3.4.1",
    "@types/mailparser": "^3.4.6",
    "@types/multer": "^1.4.13",
    "@types/node": "catalog:",
    "@types/nodemailer": "^8.0.1",
    "@types/papaparse": "^5.5.2",
    "@types/qrcode": "^1.5.6",
    "@types/supertest": "^7.2.1",
    "@vitest/runner": "^4.1.10",
    "esbuild": "0.25.8",
    "esbuild-plugin-pino": "^2.3.3",
    "pino-pretty": "^13.1.3",
    "supertest": "^7.2.2",
    "thread-stream": "3.1.0",
    "tsx": "^4.23.0",
    "vitest": "^4.1.10"
  }
}
