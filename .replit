modules = ["nodejs-24", "python-base-3.13", "postgresql-16"]

[deployment]
router = "application"
deploymentTarget = "autoscale"

[deployment.postBuild]
args = ["pnpm", "store", "prune"]
env = { "CI" = "true" }

[workflows]
runButton = "Project"

[[workflows.workflow]]
name = "pos-events-release"
author = "agent"

[workflows.workflow.metadata]
isValidation = true

[[workflows.workflow.tasks]]
task = "shell.exec"
args = "node --test scripts/validate-pos-events-release.test.mjs && node scripts/validate-pos-events-release.mjs --check && pnpm --filter @workspace/api-server exec tsx scripts/apply-test-migrations.ts && pnpm --filter @workspace/api-server run typecheck && pnpm --filter @workspace/api-server exec vitest run src/middlewares/pos.capability-audit.test.ts src/routes/pos/enote.temporary-validation.test.ts src/routes/pos/events.integration.test.ts src/routes/admin.roles.test.ts src/lib/inventory-serialization.test.ts src/lib/eventPolicy.test.ts src/lib/eventTransferDiagnostics.test.ts src/lib/loadEventTransferDiagnostics.test.ts src/lib/loadEventTransferDetail.test.ts src/routes/pos/artikli.pizza-meal-type.integration.test.ts src/routes/pos/kds-course-assignment.integration.test.ts src/__tests__/kds-routing.test.ts && pnpm --filter @workspace/api-server exec tsx scripts/run-isolated-offline-fiscal-tests.ts src/routes/pos/offline-fiscal-sync.native.integration.test.ts src/routes/pos/offline-fiscal-sync.cloud-offline.integration.test.ts && PYTHONPATH=fiscal-service uv run python -m pytest -q fiscal-service/tests && pnpm --filter @workspace/erp-web run typecheck && pnpm --filter @workspace/erp-web run test:release && pnpm --filter @workspace/pos run typecheck && pnpm --filter @workspace/pos run test:release"

[[workflows.workflow]]
name = "Project"
mode = "parallel"
author = "agent"

[[workflows.workflow.tasks]]
task = "workflow.run"
args = "pos-events-release"

[[workflows.workflow.tasks]]
task = "workflow.run"
args = "pos-manual-packages"

[[workflows.workflow]]
name = "pos-manual-packages"
author = "agent"

[[workflows.workflow.tasks]]
task = "shell.exec"
args = "uv run python -m pytest -q tests/test_generate_pos_manual_pdf.py"

[workflows.workflow.metadata]
isValidation = true

[agent]
stack = "PNPM_WORKSPACE"
expertMode = true

[postMerge]
path = "scripts/post-merge.sh"
timeoutMs = 120000

[nix]
channel = "stable-25_05"
packages = ["android-tools", "cargo", "freetype", "glibcLocales", "gradle", "gumbo", "harfbuzz", "jbig2dec", "jdk17", "lcms2", "libiconv", "libimagequant", "libjpeg", "libjpeg_turbo", "libtiff", "libwebp", "libxcrypt", "mupdf", "openjpeg", "openssl", "pkg-config", "rustc", "swig", "tcl", "tk", "xcbuild", "xcodebuild", "zlib", "firefox", "geckodriver"]

[userenv]

[userenv.shared]
ERP_PONUDNIK_DAVCNA = "84040653"
SMTP_HOST = "mail.mikrona.si"
SMTP_PORT = "465"

